#!/bin/bash

# Launcher wrapper for omarchy-agent with Google Antigravity support

agent=$(omarchy-default-agent 2>/dev/null)

if [[ "$agent" == "antigravity" || "$agent" == "agy" ]]; then
  inline=false
  pick=false
  prompt=""

  while (($#)); do
    case "$1" in
      --inline)
        inline=true
        shift
        ;;
      --pick)
        pick=true
        shift
        ;;
      --prompt)
        prompt=${2:?--prompt needs a value}
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  [[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

  command=(agy --dangerously-skip-permissions)
  [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")

  if [[ $inline == "true" ]]; then
    exec "${command[@]}"
  else
    exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
  fi
fi

exec /usr/bin/omarchy-agent "$@"
